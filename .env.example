# Copy this file to ".env" and fill in real values.
# NEVER commit the real ".env" file to Git — it stays only on your computer.

# --- Blockchain RPC endpoints ---
# SOLANA_RPC_URL is used starting Stage 3. A free, official public endpoint
# is available (rate-limited, no guarantee of uptime — fine for V1):
#   SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# For heavier use later, a dedicated free-tier RPC provider (e.g. Helius)
# can be swapped in here later without changing any code — just this URL.
SOLANA_RPC_URL=

# The rest are not required yet. Will be needed starting Stage 4/5/11.
ETHEREUM_RPC_URL=
BASE_RPC_URL=
BNB_RPC_URL=
ARBITRUM_RPC_URL=
ROBINHOOD_RPC_URL=

# --- Discord alerts ---
# Not required yet. Will be needed starting Stage 11.
DISCORD_WEBHOOK_URL=

# --- Market data ---
# Not required yet. Will be needed starting Stage 5.
# We will research and confirm a specific provider together before this
# is used for anything.
MARKET_DATA_API_KEY=

# --- Database ---
DATABASE_PATH=data/crypto_bot.db

# --- Scanner behavior ---
SCAN_INTERVAL_SECONDS=60
ALERT_SCORE_THRESHOLD=80
MAX_TOKENS_PER_CHAIN=100
MAX_CONCURRENT_REQUESTS=10

# --- General ---
LOG_LEVEL=INFO
DRY_RUN=true
